[Unit]
Description=BTC Futures Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kosang
WorkingDirectory=/home/kosang/Mybox
EnvironmentFile=/home/kosang/Mybox/.env
ExecStart=/usr/bin/python3 /home/kosang/Mybox/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
